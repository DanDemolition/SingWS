# Local/editor clutter
.DS_Store
.cache/
.pytest_cache/
__pycache__/
*.pyc

# Local environment and secrets
.env
venv/
# No trailing slash: .venv may be a symlink to .venv-universal when the system
# Python framework is unavailable, and "\.venv/" would not match a symlink.
.venv
.venv-test/
.venv-test-brew/
.venv-universal/

# Build outputs and packaged artifacts
build/
dist/
*.app
*.dmg
*.pkg
*.zip
*.log

# Large local media/tooling artifacts
bin/
bin/ffmpeg*
bin/ffprobe*
gstreamer-sdk/
gstreamer-1.0-*.pkg
openkj.sqlite

# Backups
*.bak
*.bak*
*.icns.bak*
*.iconset.bak*/
tmp_live_test_backup/

# Current PyInstaller specs are source for the active release builders.
# Stable (version-agnostic) names so the version lives only in APP_VERSION.
*.spec
!SingWS-universal.spec
!SingWS-x86_64.spec
!SingWS-arm64.spec

# IINA-derived media stack (GPL, ~117 MB of prebuilt dylibs). Not vendored into
# the repo: point SINGWS_MPV_FRAMEWORKS at a local copy, or see
# native/mpv_bridge/README.md.
vendor/mpv-iina-Frameworks/
native_dual_view/
# Built native bridge; produced by native/mpv_bridge/build_bridge.sh
native/mpv_bridge/libsingws_mpv_bridge.dylib
qtvenv/

# Local-only: virtual environments, build trees, machine backups and receipts.
# The backups hold profile data and credentials and must never be committed.
.venv*
qtvenv*
build-*/
dist 2/
dist-*/
local-installs/
history-reset-backups/
retired-test-builds/
server-deployments/
# Finder duplicates
* 2.py
# Built native libraries and local extension builds (rebuilt by the build scripts)
native/karafun_capture/*.dylib
native/mpv_bridge/*.dylib
*.cpython-*-darwin.so
*.egg-info/
# The server is its own repository (SingWS-Server)
SingWS-Server/
