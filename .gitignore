# Local/editor clutter
.DS_Store
.cache/
.pytest_cache/
__pycache__/
*.pyc

# Local environment and secrets
.env
venv/
# No trailing slash: .venv may be a symlink to .venv-universal when the system
# Python framework is unavailable, and "\.venv/" would not match a symlink.
.venv
.venv-test/
.venv-test-brew/
.venv-universal/
.venv-intel-legacy/
.legacy-intel-wheelhouse/

# Build outputs and packaged artifacts
build/
dist/
build-intel-legacy-input/
build-intel-legacy/
dist-intel-legacy/
*.app
*.dmg
*.pkg
*.zip
*.log
signalsmith_audio_native.cpython-312-darwin.so

# Large local media/tooling artifacts
bin/
bin/ffmpeg*
bin/ffprobe*
gstreamer-sdk/
gstreamer-1.0-*.pkg
openkj.sqlite

# Backups
*.bak
*.bak*
*.icns.bak*
*.iconset.bak*/
tmp_live_test_backup/

# Current PyInstaller specs are source for the active release builders.
# Stable (version-agnostic) names so the version lives only in APP_VERSION.
*.spec
!SingWS-universal.spec
!SingWS-x86_64.spec
!SingWS-arm64.spec
!SingWS-intel-legacy.spec
