import { TabWidget, ListView, Button, LineEdit, SpinBox } from "std-widgets.slint";

export struct ListItem { header: bool, section: string, title: string, helper: string, text: string, first-time: bool, tag: string, id: int, singer: string, artist: string, song: string, key: int, tempo: int }

component Pill inherits Rectangle {
    in property <string> label;
    background: #3b2a6e; border-radius: 8px; height: 22px;
    width: lbl.preferred-width + 16px;
    lbl := Text { text: root.label; color: #b6ff3b; font-size: 11px; font-weight: 700; x: 8px; vertical-alignment: center; height: parent.height; }
}

component Banner inherits Rectangle {
    in property <string> text;
    in property <string> kind;
    visible: root.text != "";
    height: root.text != "" ? t.preferred-height + 14px : 0px;
    border-radius: 6px;
    background: root.kind == "ok" ? #12301f : root.kind == "warn" ? #33290f : #3a1414;
    t := Text { text: root.text; color: white; font-size: 12px; wrap: word-wrap; x: 7px; y: 7px; width: parent.width - 14px; }
}

component WaitRow inherits Rectangle {
    in property <ListItem> it;
    in property <bool> live;
    in property <bool> sure;
    callback edit();
    callback add();
    callback remove();
    callback restore();
    property <bool> actions: root.live && !it.header && (it.section == "waitlist" || it.section == "removed");
    height: it.header ? lay.preferred-height : max(lay.preferred-height, root.actions ? 48px : 40px);
    border-radius: 6px;
    background: it.header ? (it.section == "pending_acceptance" ? #0e3a52 : it.section == "removed" ? #4a1d1d : #1f2540) : (it.first-time ? #16341f : #1a1838);
    accessible-role: text;
    accessible-label: it.header ? it.title : it.text;
    lay := HorizontalLayout { padding: 8px; spacing: 8px;
        VerticalLayout { horizontal-stretch: 1; spacing: 2px;
            Text { text: it.header ? it.title : it.text; color: it.header ? #e8e6f5 : white; font-size: it.header ? 14px : 13px; font-weight: it.header ? 700 : 400; wrap: word-wrap; }
            if it.header && it.helper != "" : Text { text: it.helper; color: #9a97c0; font-size: 12px; wrap: word-wrap; } }
        if it.tag != "" : Pill { label: it.tag; y: 0px; }
        if root.actions && it.section == "waitlist" : Button { text: "Edit"; clicked => { root.edit(); } accessible-label: "Edit " + it.singer + "'s request"; }
        if root.actions && it.section == "waitlist" : Button { text: "Add"; clicked => { root.add(); } accessible-label: "Add " + it.singer + " to the rotation"; }
        if root.actions && it.section == "waitlist" : Button { text: root.sure ? "Sure?" : "Remove"; clicked => { root.remove(); } accessible-label: (root.sure ? "Confirm removing " : "Remove ") + it.singer + " from the waitlist"; }
        if root.actions && it.section == "removed" : Button { text: "Restore"; clicked => { root.restore(); } accessible-label: "Restore " + it.singer + " to the waitlist"; }
    }
}

export component App inherits Window {
    title: "SingWS";
    preferred-width: 980px; preferred-height: 680px;
    background: #14101f;
    // connection
    in-out property <string> server-url;
    in-out property <string> tenant;
    in property <string> conn-status;
    in property <bool> live;
    in property <string> result-text;
    in property <string> result-kind;
    callback connect(string, string, string);
    callback disconnect();
    // ticker
    in property <string> ticker-text;
    in property <string> ticker-message;
    in property <string> ticker-status;
    in property <[string]> singers;
    in-out property <string> message-draft;
    callback save-message(string);
    callback set-message-shown(bool);
    // waitlist
    in property <string> waitlist-status;
    in property <[ListItem]> waitlist;
    in property <int> start-tab: 0;
    callback wl-add(int, string);
    callback wl-remove(int, string);
    callback wl-restore(int, string);
    callback wl-edit(int, string, string, string, int, int);
    in-out property <int> sure-id: 0;
    in-out property <int> edit-id: 0;
    in-out property <string> edit-singer;
    in-out property <string> edit-artist;
    in-out property <string> edit-title;
    in-out property <int> edit-key;
    in-out property <int> edit-tempo;
    property <string> pin;

    Timer { interval: 3s; running: root.sure-id != 0; triggered => { root.sure-id = 0; } }

    VerticalLayout { padding: 10px; spacing: 8px;
        // connection bar: the host PIN is typed here, passed to the relay client and never stored
        Rectangle { background: #1a1838; border-radius: 8px; height: 46px;
            HorizontalLayout { padding: 8px; spacing: 8px;
                LineEdit { text <=> root.server-url; placeholder-text: "Server, e.g. https://wskar.com"; horizontal-stretch: 2; accessible-label: "Server address"; }
                LineEdit { text <=> root.tenant; placeholder-text: "Venue"; width: 90px; accessible-label: "Venue name"; }
                pin-edit := LineEdit { text <=> root.pin; placeholder-text: "Host PIN"; input-type: password; width: 100px; accessible-label: "Host PIN"; accepted => { root.connect(root.server-url, root.tenant, root.pin); root.pin = ""; } }
                Button { text: "Connect"; clicked => { root.connect(root.server-url, root.tenant, root.pin); root.pin = ""; } }
                Button { text: "Disconnect"; clicked => { root.disconnect(); } }
                Text { text: root.conn-status; color: root.live ? #b6ff3b : #9a97c0; font-size: 12px; vertical-alignment: center; min-width: 120px; accessible-role: text; }
            }
        }
        Banner { text: root.result-text; kind: root.result-kind; }

        TabWidget { current-index: root.start-tab;
            Tab { title: "Ticker";
                VerticalLayout { padding: 14px; spacing: 10px;
                    Text { text: root.live ? "TICKER" : "TICKER (read-only: not connected to the app)"; color: #e8e6f5; font-size: 15px; font-weight: 700; }
                    Text { text: root.ticker-status; color: #9a97c0; font-size: 12px; wrap: word-wrap; }
                    // the exact string the audience ticker scrolls
                    Rectangle { background: #0b0816; border-radius: 8px; border-color: #2a2650; border-width: 1px; height: 56px; clip: true;
                        Text { text: root.ticker-text; color: white; font-size: 20px; x: 14px; width: parent.width - 28px; height: parent.height; vertical-alignment: center; overflow: elide; accessible-role: text; accessible-label: "Ticker text: " + root.ticker-text; } }
                    if root.ticker-message != "" : Text { text: "Custom message: " + root.ticker-message; color: #c9c6e8; font-size: 13px; wrap: word-wrap; }
                    if root.live : Rectangle { background: #12102a; border-radius: 8px; border-color: #2a2650; border-width: 1px; height: 84px;
                        VerticalLayout { padding: 8px; spacing: 6px;
                            Text { text: "CUSTOM MESSAGE (codes: %m_curSinger %curSong %nextSinger)"; color: #6d6a99; font-size: 10px; font-weight: 700; }
                            HorizontalLayout { spacing: 6px;
                                LineEdit { text <=> root.message-draft; placeholder-text: "Type a ticker message"; horizontal-stretch: 1; accessible-label: "Custom ticker message"; }
                                Button { text: "Save message"; enabled: root.message-draft.character-count <= 200; clicked => { root.save-message(root.message-draft); } }
                                Button { text: "Show on ticker"; clicked => { root.set-message-shown(true); } }
                                Button { text: "Hide"; clicked => { root.set-message-shown(false); } }
                            } } }
                    ListView {
                        for s[i] in root.singers : Rectangle { background: #1a1838; border-radius: 6px; height: 32px;
                            Text { text: (i + 1) + ".  " + s; color: #c9c6e8; font-size: 13px; x: 10px; vertical-alignment: center; height: parent.height; accessible-role: text; } }
                    }
                }
            }
            Tab { title: "Waitlist";
                VerticalLayout { padding: 14px; spacing: 10px;
                    Text { text: root.live ? "WAITLIST" : "WAITLIST (read-only: not connected to the app)"; color: #e8e6f5; font-size: 15px; font-weight: 700; }
                    Text { text: root.waitlist-status; color: #9a97c0; font-size: 12px; wrap: word-wrap; }
                    ListView {
                        for it in root.waitlist : WaitRow { it: it; live: root.live; sure: root.sure-id == it.id && it.id != 0;
                            edit => { root.edit-id = it.id; root.edit-singer = it.singer; root.edit-artist = it.artist; root.edit-title = it.song; root.edit-key = it.key; root.edit-tempo = it.tempo; }
                            add => { root.wl-add(it.id, it.singer); }
                            remove => { if (root.sure-id == it.id) { root.sure-id = 0; root.wl-remove(it.id, it.singer); } else { root.sure-id = it.id; } }
                            restore => { root.wl-restore(it.id, it.singer); } }
                    }
                }
            }
        }
    }

    // the Edit form: changes singer / song / key / tempo of the SAME request (its id and place never change); the app tells the server
    if root.edit-id != 0 : Rectangle { background: #aa000000;
        TouchArea { }
        Rectangle { width: min(root.width - 40px, 460px); height: 330px; background: #1a1838; border-radius: 10px; border-color: #2a2650; border-width: 1px;
            VerticalLayout { padding: 16px; spacing: 6px;
                Text { text: "Edit waitlist request"; color: white; font-size: 15px; font-weight: 700; }
                Text { text: "Singer"; color: #c9c6e8; font-size: 12px; }
                LineEdit { text <=> root.edit-singer; accessible-label: "Singer (required)"; }
                Text { text: "Song title"; color: #c9c6e8; font-size: 12px; }
                LineEdit { text <=> root.edit-title; accessible-label: "Song title (required)"; }
                Text { text: "Artist"; color: #c9c6e8; font-size: 12px; }
                LineEdit { text <=> root.edit-artist; accessible-label: "Artist"; }
                HorizontalLayout { spacing: 8px;
                    Text { text: "Key"; color: #c9c6e8; font-size: 12px; vertical-alignment: center; }
                    SpinBox { value <=> root.edit-key; minimum: -12; maximum: 12; accessible-label: "Key, -12 to 12"; }
                    Text { text: "Tempo"; color: #c9c6e8; font-size: 12px; vertical-alignment: center; }
                    SpinBox { value <=> root.edit-tempo; minimum: -30; maximum: 30; accessible-label: "Tempo change, -30 to 30"; }
                }
                HorizontalLayout { spacing: 8px; alignment: end;
                    Button { text: "Cancel"; clicked => { root.edit-id = 0; } }
                    Button { text: "Save"; primary: true; enabled: root.edit-singer != "" && root.edit-title != "";
                        clicked => { root.wl-edit(root.edit-id, root.edit-singer, root.edit-artist, root.edit-title, root.edit-key, root.edit-tempo); root.edit-id = 0; } }
                }
            } } }
}
